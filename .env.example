# Supabase設定
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key（サーバー側API専用・絶対に公開しないこと）
# /api/routing と /api/requests がこのキーを使用する。Vercel に未設定だとお客様フォーム送信が失敗する。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack Webhook URL（任意）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# EmailJS設定（クライアントサイドで使用するためNEXT_PUBLIC_プレフィックス）
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
